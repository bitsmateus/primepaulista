# ===== Banco de dados PostgreSQL =====
# Em PRODUÇÃO (backend rodando no mesmo servidor do banco): use o HOST INTERNO
# Ex.: postgres://postgres:SENHA@prime_paulista_postgres:5432/prime_paulista?sslmode=disable
#
# Em DESENVOLVIMENTO (rodando da máquina local): use o HOST EXTERNO/PÚBLICO
# Ex.: postgres://postgres:SENHA@SEU_IP_PUBLICO:PORTA_EXTERNA/prime_paulista?sslmode=disable
DATABASE_URL=

# ===== Autenticação (JWT) =====
# Gere uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=

# ===== Servidor =====
PORT=3333

# ===== MinIO (armazenamento de fotos/recibos) =====
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=prime-paulista
